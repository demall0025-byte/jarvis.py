logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")

# -------------------- AUDIO (WAV) --------------------
pygame.mixer.init()
_executor = ThreadPoolExecutor(max_workers=4)

_sound_cache = {}

def play_sound(path: str | None):
    if not path:
        return
    try:
        if path not in _sound_cache:
            if os.path.exists(path):
                _sound_cache[path] = pygame.mixer.Sound(path)
            else:
                return
        _sound_cache[path].play()
    except Exception as e:
        logging.debug(f"play_sound error: {e}")


def safe_submit(fn, *args, **kwargs):
    try:
        return fn(*args, **kwargs)
    except Exception as e:
        logging.error(f"Ошибка в {getattr(fn, '__name__', str(fn))}: {e}")
        return None


# -------------------- COMMANDS --------------------

def action_exit():
    logging.info("🛑 Выключение помощника...")
    _executor.submit(play_sound, SOUNDS.get("shutdown"))
    time.sleep(1)
    os._exit(0)


def action_shutdown():
    os.system("shutdown /s /t 1")


def action_restart():
    os.system("shutdown /r /t 1")


def action_lock():
    if platform.system() == "Windows":
        ctypes.windll.user32.LockWorkStation()


def action_minimize_all_windows():
    # Win+Down (минимизировать)
    if platform.system() != "Windows":
        return
    user32 = ctypes.WinDLL("user32")
    VK_LWIN = 0x5B
    VK_D = 0x44
    KEYEVENTF_KEYDOWN = 0x0000
    KEYEVENTF_KEYUP = 0x0002
    user32.keybd_event(ctypes.c_ubyte(VK_LWIN), 0, KEYEVENTF_KEYDOWN, 0)
    user32.keybd_event(ctypes.c_ubyte(VK_D), 0, KEYEVENTF_KEYDOWN, 0)
    time.sleep(0.05)
    user32.keybd_event(ctypes.c_ubyte(VK_D), 0, KEYEVENTF_KEYUP, 0)
    user32.keybd_event(ctypes.c_ubyte(VK_LWIN), 0, KEYEVENTF_KEYUP, 0)


def action_empty_recycle_bin():
    # Win SHEmptyRecycleBinW
    if platform.system() != "Windows":
        return
    SHEmptyRecycleBin = ctypes.windll.shell32.SHEmptyRecycleBinW
    flags = 0x00000001 | 0x00000002 | 0x00000004
    SHEmptyRecycleBin(None, None, flags)


def open_app(app_path: str):
    try:
        if platform.system() == "Windows":
            os.startfile(app_path)
    except Exception as e:
        logging.error(f"Ошибка при открытии {app_path}: {e}")


def action_open_camera():
    # пытаемся открыть OBS Studio и камеру. Если не нужно — удалите.
    try:
        open_app(r"C:\ProgramData\Microsoft\Windows\Start Menu\Programs\OBS Studio.lnk")
    except Exception:
        pass
    try:
        subprocess.run(["start", "microsoft.windows.camera:"], shell=True)
    except Exception as e:
        logging.error(f"Ошибка при запуске камеры: {e}")


def action_search(query: str):
    # Google search
    q = (query or "").strip()
    if not q:
        return
    encoded_query = urllib.parse.quote(q)
    url = f"https://www.google.com/search?q={encoded_query}"
    import webbrowser
    webbrowser.open(url)


def action_restart_explorer():
    try:
        subprocess.run("taskkill /f /im explorer.exe", shell=True)
        time.sleep(1)
        subprocess.Popen("explorer.exe", shell=True)
    except Exception as e:
        logging.error(f"Ошибка при перезапуске проводника: {e}")


